[Unit]
Description=Twilight Go Telegram Bot Bridge
After=network-online.target twilight.service
Wants=network-online.target
PartOf=twilight.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=twilight
Group=twilight
WorkingDirectory=/opt/twilight
ExecStart=/opt/twilight/bin/twilight bot --config config.toml

EnvironmentFile=-/opt/twilight/.env

# 以专用低权限账号运行并收紧沙箱：自动更新、配置编辑、上传、备份与迁移都会写文件，
# 以 root 运行时任何路径类瑕疵都会变成 root 写文件。只放行项目目录可写；
# 若把 backup_dir / upload_folder / databases_dir 配到项目目录以外，请把那些目录
# 追加到 ReadWritePaths。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/twilight
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
UMask=0077

LimitNOFILE=65535
MemoryMax=512M
MemoryHigh=384M

Restart=always
RestartSec=10

TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=twilight-bot

[Install]
WantedBy=multi-user.target
